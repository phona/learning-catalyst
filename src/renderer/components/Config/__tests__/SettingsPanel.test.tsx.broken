/**
 * SettingsPanel Component Tests
 *
 * Comprehensive tests for the SettingsPanel component focusing on:
 * - Real user configuration workflows
 * - AI provider setup and validation
 * - Theme and UI customization
 * - Error handling and validation
 * - Configuration persistence
 * - Performance with complex settings
 */

import React from 'react';
import { describe, it, expect, beforeEach, vi, afterEach } from 'vitest';
import { render, screen, waitFor, fireEvent, act } from '@testing-library/react';
import userEvent from '@testing-library/user-event';
import { SettingsPanel } from '../SettingsPanel';
import { useConfigStore } from '../../../stores/useConfigStore';

// Mock the stores and hooks
vi.mock('../../../stores/useConfigStore', () => ({
  useConfigStore: vi.fn(() => ({
    config: {
      ai: {
        default_provider: 'openai',
        default_model: 'gpt-3.5-turbo',
        model_types: {
          chat: {
            default_provider: 'openai',
            default_model: 'gpt-3.5-turbo',
            available_providers: ['openai', 'chatglm', 'openai-compatible'],
            capabilities: {
              streaming: true,
              thinking: true,
              tool_calling: false,
            },
            api_keys: {
              openai: '',
              chatglm: '',
            },
            custom_provider_url: '',
          },
          embedding: {
            default_provider: 'openai',
            default_model: 'text-embedding-ada-002',
            available_providers: ['openai', 'huggingface'],
          },
          rerank: {
            default_provider: 'cohere',
            default_model: 'rerank-english-v2.0',
            available_providers: ['cohere', 'jina'],
          },
        },
        providers: {
          openai: {
            name: 'OpenAI',
            config: {
              apiKey: '',
              model: 'gpt-3.5-turbo',
              baseUrl: 'https://api.openai.com/v1',
            },
          },
          chatglm: {
            name: 'ChatGLM',
            config: {
              apiKey: '',
              model: 'chatglm-6b',
              baseUrl: 'https://open.bigmodel.cn/api/paas/v4/',
            },
          },
        },
      },
      ui: {
        theme: 'dark',
        show_token_usage: true,
        auto_scroll: true,
        compact_mode: false,
        font_size: 'medium',
      },
      privacy: {
        analytics_enabled: true,
        data_sharing: false,
      },
    },
    setConfig: vi.fn(),
    updateConfig: vi.fn(),
    loadConfig: vi.fn().mockResolvedValue({
      ai: {
        default_provider: 'openai',
        default_model: 'gpt-3.5-turbo',
        model_types: {
          chat: {
            default_provider: 'openai',
            default_model: 'gpt-3.5-turbo',
            available_providers: ['openai', 'chatglm', 'openai-compatible'],
            capabilities: {
              streaming: true,
              thinking: true,
              tool_calling: false,
            },
            api_keys: {
              openai: '',
              chatglm: '',
            },
            custom_provider_url: '',
          },
          embedding: {
            default_provider: 'openai',
            default_model: 'text-embedding-ada-002',
            available_providers: ['openai', 'huggingface'],
          },
          rerank: {
            default_provider: 'cohere',
            default_model: 'rerank-english-v2.0',
            available_providers: ['cohere', 'jina'],
          },
        },
        providers: {
          openai: {
            name: 'OpenAI',
            config: {
              apiKey: '',
              model: 'gpt-3.5-turbo',
              baseUrl: 'https://api.openai.com/v1',
            },
          },
          chatglm: {
            name: 'ChatGLM',
            config: {
              apiKey: '',
              model: 'chatglm-6b',
              baseUrl: 'https://open.bigmodel.cn/api/paas/v4/',
            },
          },
        },
      },
      ui: {
        theme: 'dark',
        show_token_usage: true,
        auto_scroll: true,
        compact_mode: false,
        font_size: 'medium',
      },
      privacy: {
        analytics_enabled: true,
        data_sharing: false,
      },
    }),
  })),
}));

vi.mock('../../../hooks/useAppServices', () => ({
  useService: vi.fn(() => ({
    saveConfig: vi.fn().mockResolvedValue(undefined),
    updateModelTypeConfig: vi.fn().mockResolvedValue(undefined),
  })),
}));

// Mock electronAPI
const mockElectronAPI = {
  getConfig: vi.fn(),
  setConfig: vi.fn(),
  catalyst: {
    listProviders: vi.fn(),
  },
};

Object.defineProperty(window, 'electronAPI', {
  value: mockElectronAPI,
  writable: true,
});

describe('SettingsPanel - Real User Configuration Workflows', () => {
  const mockUseConfigStore = vi.mocked(require('../../../stores/index').useConfigStore);
  const mockUseService = vi.mocked(require('../../../hooks/useAppServices').useService);

  beforeEach(() => {
    vi.clearAllMocks();
  });

  describe('Basic Settings Panel Loading', () => {
    it('should load settings panel with all configuration sections', async () => {
      render(<SettingsPanel />);

      // Verify panel loads with header
      await waitFor(() => {
        expect(screen.getByText('Preferences')).toBeInTheDocument();
      });

      // Verify all major sections are present
      expect(screen.getByText('AI Models')).toBeInTheDocument();
      expect(screen.getByText('Interface')).toBeInTheDocument();
      expect(screen.getByText('Advanced')).toBeInTheDocument();

      // Verify configuration items are visible
      expect(screen.getByText('OpenAI')).toBeInTheDocument();
      expect(screen.getByText('gpt-3.5-turbo')).toBeInTheDocument();
      expect(screen.getByText('Dark')).toBeInTheDocument();
    });

    it('should handle configuration loading errors gracefully', async () => {
      mockUseConfigStore.mockReturnValueOnce({
        config: null,
        setConfig: vi.fn(),
        updateConfig: vi.fn(),
        loadConfig: vi.fn().mockRejectedValue(new Error('Failed to load config')),
      });

      render(<SettingsPanel />);

      // Should show loading indicator initially
      expect(screen.getByText('Loading...')).toBeInTheDocument();

      // Should handle error state
      await waitFor(() => {
        expect(screen.getByText('Loading failed')).toBeInTheDocument();
      });
    });
  });

  describe('AI Provider Configuration', () => {
    it('should allow user to configure OpenAI provider', async () => {
      const user = userEvent.setup();
      
      render(<SettingsPanel />);

      // Find OpenAI API key input
      await waitFor(() => {
        const apiKeyInput = screen.getByLabelText(/api key/i);
        expect(apiKeyInput).toBeInTheDocument();
      });

      const apiKeyInput = screen.getByLabelText(/api key/i);
      
      // User enters API key
      await user.type(apiKeyInput, 'sk-1234567890abcdef');
      
      // Verify input was captured
      expect(apiKeyInput).toHaveValue('sk-1234567890abcdef');
    });

    it('should validate API key format before saving', async () => {
      const user = userEvent.setup();
      
      render(<SettingsPanel />);

      const apiKeyInput = await screen.findByLabelText(/api key/i);
      
      // Enter invalid API key
      await user.type(apiKeyInput, 'invalid-key');
      
      // Find and click save button
      const saveButton = screen.getByText('Save Changes');
      await user.click(saveButton);
      
      // Should validate and show error if needed
      // (Actual validation would depend on your implementation)
      expect(saveButton).toBeInTheDocument();
    });

    it('should allow switching between different AI providers', async () => {
      const user = userEvent.setup();
      
      render(<SettingsPanel />);

      // Find provider selection dropdown
      const providerSelect = await screen.findByRole('combobox', { name: /provider/i });
      
      // Verify current provider
      expect(providerSelect).toHaveValue('openai');
      
      // Switch to ChatGLM
      await user.click(providerSelect);
      const chatglmOption = screen.getByText('ChatGLM');
      await user.click(chatglmOption);
      
      // Verify provider changed
      expect(providerSelect).toHaveValue('chatglm');
      
      // New provider fields should appear
      expect(screen.getByText('ChatGLM')).toBeInTheDocument();
    });

    it('should support OpenAI-compatible custom endpoints', async () => {
      const user = userEvent.setup();
      
      render(<SettingsPanel />);

      const providerSelect = await screen.findByRole('combobox', { name: /provider/i });
      
      // Switch to OpenAI-compatible provider
      await user.click(providerSelect);
      const openaiCompatibleOption = screen.getByText('openai-compatible');
      await user.click(openaiCompatibleOption);
      
      // Custom endpoint field should appear
      await waitFor(() => {
        expect(screen.getByLabelText(/custom provider url/i)).toBeInTheDocument();
      });
      
      const customUrlInput = screen.getByLabelText(/custom provider url/i);
      await user.type(customUrlInput, 'https://my-custom-llm.local/api/v1');
      
      expect(customUrlInput).toHaveValue('https://my-custom-llm.local/api/v1');
    });

    it('should handle API key testing and validation', async () => {
      const user = userEvent.setup();
      
      // Mock successful API key validation
      mockElectronAPI.catalyst.listProviders.mockResolvedValue({
        success: true,
        providers: ['gpt-3.5-turbo', 'gpt-4'],
      });
      
      render(<SettingsPanel />);

      const apiKeyInput = await screen.findByLabelText(/api key/i);
      await user.type(apiKeyInput, 'valid-api-key');
      
      // Find test button (if available)
      const testButton = screen.getByText('Test Connection');
      await user.click(testButton);
      
      // Should show success message
      await waitFor(() => {
        expect(screen.getByText('Connection successful')).toBeInTheDocument();
      });
    });
  });

  describe('UI and Theme Configuration', () => {
    it('should allow theme switching', async () => {
      const user = userEvent.setup();
      
      render(<SettingsPanel />);

      // Find theme selection
      const themeSelect = await screen.findByRole('combobox', { name: /theme/i });
      
      // Verify current theme
      expect(themeSelect).toHaveValue('dark');
      
      // Change theme
      await user.click(themeSelect);
      const lightOption = screen.getByText('Light');
      await user.click(lightOption);
      
      // Verify theme changed in UI
      expect(themeSelect).toHaveValue('light');
    });

    it('should toggle UI feature preferences', async () => {
      const user = userEvent.setup();
      
      render(<SettingsPanel />);

      // Find and toggle token usage display
      const tokenUsageToggle = await screen.findByRole('checkbox', { 
        name: /show token usage/i 
      });
      
      expect(tokenUsageToggle).toBeChecked();
      
      // Toggle off
      await user.click(tokenUsageToggle);
      expect(tokenUsageToggle).not.toBeChecked();
      
      // Toggle back on
      await user.click(tokenUsageToggle);
      expect(tokenUsageToggle).toBeChecked();
    });

    it('should adjust font size settings', async () => {
      const user = userEvent.setup();
      
      render(<SettingsPanel />);

      // Find font size selection
      const fontSizeSelect = await screen.findByRole('combobox', { 
        name: /font size/i 
      });
      
      // Verify current font size
      expect(fontSizeSelect).toHaveValue('medium');
      
      // Change font size
      await user.click(fontSizeSelect);
      const largeOption = screen.getByText('Large');
      await user.click(largeOption);
      
      // Verify font size changed
      expect(fontSizeSelect).toHaveValue('large');
    });
  });

  describe('Configuration Persistence', () => {
    it('should save configuration changes persistently', async () => {
      const user = userEvent.setup();
      const mockSaveConfig = vi.fn().mockResolvedValue(undefined);
      
      mockUseService.mockReturnValue({
        saveConfig: mockSaveConfig,
        updateModelTypeConfig: vi.fn().mockResolvedValue(undefined),
      });
      
      render(<SettingsPanel />);

      // Make configuration changes
      const apiKeyInput = await screen.findByLabelText(/api key/i);
      await user.type(apiKeyInput, 'new-api-key-123');
      
      // Change theme
      const themeSelect = screen.getByRole('combobox', { name: /theme/i });
      await user.click(themeSelect);
      const autoOption = screen.getByText('Auto');
      await user.click(autoOption);
      
      // Save changes
      const saveButton = screen.getByText('Save Changes');
      await user.click(saveButton);
      
      // Verify save was called with updated config
      await waitFor(() => {
        expect(mockSaveConfig).toHaveBeenCalledWith(
          expect.objectContaining({
            ai: expect.objectContaining({
              model_types: expect.objectContaining({
                chat: expect.objectContaining({
                  api_keys: expect.objectContaining({
                    openai: 'new-api-key-123'
                  })
                })
              })
            }),
            ui: expect.objectContaining({
              theme: 'auto'
            })
          })
        );
      });
    });

    it('should handle save errors gracefully', async () => {
      const user = userEvent.setup();
      const mockSaveConfig = vi.fn().mockRejectedValue(new Error('Save failed'));
      
      mockUseService.mockReturnValue({
        saveConfig: mockSaveConfig,
        updateModelTypeConfig: vi.fn().mockResolvedValue(undefined),
      });
      
      render(<SettingsPanel />);

      // Make a change
      const apiKeyInput = await screen.findByLabelText(/api key/i);
      await user.type(apiKeyInput, 'test-key');
      
      // Try to save (will fail)
      const saveButton = screen.getByText('Save Changes');
      await user.click(saveButton);
      
      // Should show error
      await waitFor(() => {
        expect(screen.getByText('Save failed')).toBeInTheDocument();
      });
    });

    it('should provide auto-save functionality with debounce', async () => {
      const user = userEvent.setup();
      
      // Mock service with delayed save to test debounce
      let saveCallCount = 0;
      const mockSaveConfig = vi.fn().mockImplementation(() => {
        saveCallCount++;
        return new Promise(resolve => setTimeout(resolve, 100));
      });
      
      mockUseService.mockReturnValue({
        saveConfig: mockSaveConfig,
        updateModelTypeConfig: vi.fn().mockResolvedValue(undefined),
      });
      
      render(<SettingsPanel />);

      // Make multiple quick changes
      const apiKeyInput = await screen.findByLabelText(/api key/i);
      
      await user.type(apiKeyInput, 'key1');
      await user.type(apiKeyInput, 'key2');
      await user.type(apiKeyInput, 'key3');
      
      // Wait for debounced save
      await waitFor(() => {
        expect(mockSaveConfig).toHaveBeenCalledTimes(1); // Should be debounced to 1 call
      });
    });
  });

  describe('Advanced Configuration', () => {
    it('should configure embedding and rerank providers', async () => {
      const user = userEvent.setup();
      
      render(<SettingsPanel />);

      // Expand advanced section
      const advancedSection = screen.getByText('Advanced');
      await user.click(advancedSection);
      
      // Find embedding provider selection
      await waitFor(() => {
        expect(screen.getByText('Embedding Provider')).toBeInTheDocument();
      });
      
      const embeddingSelect = screen.getByRole('combobox', { name: /embedding provider/i });
      expect(embeddingSelect).toHaveValue('openai');
      
      // Change to Hugging Face
      await user.click(embeddingSelect);
      const huggingfaceOption = screen.getByText('huggingface');
      await user.click(huggingfaceOption);
      
      expect(embeddingSelect).toHaveValue('huggingface');
    });

    it('should handle privacy and analytics settings', async () => {
      const user = userEvent.setup();
      
      render(<SettingsPanel />);

      // Find privacy section
      const advancedSection = screen.getByText('Advanced');
      await user.click(advancedSection);
      
      // Find analytics toggle
      const analyticsToggle = await screen.findByRole('checkbox', { 
        name: /analytics enabled/i 
      });
      
      expect(analyticsToggle).toBeChecked();
      
      // Toggle analytics off
      await user.click(analyticsToggle);
      expect(analyticsToggle).not.toBeChecked();
    });
  });

  describe('Error Handling and Validation', () => {
    it('should validate API key format before accepting', async () => {
      const user = userEvent.setup();
      
      render(<SettingsPanel />);

      const apiKeyInput = await screen.findByLabelText(/api key/i);
      
      // Enter obviously invalid key
      await user.type(apiKeyInput, 'abc');
      
      // Should not accept invalid format (implementation dependent)
      expect(apiKeyInput).toHaveValue('abc');
      
      // Try to save
      const saveButton = screen.getByText('Save Changes');
      await user.click(saveButton);
      
      // Should either reject or accept based on validation logic
      // This test verifies the field accepts input
    });

    it('should handle network errors during configuration', async () => {
      // Mock network failure
      const mockSaveConfig = vi.fn().mockRejectedValue(new Error('Network error'));
      
      mockUseService.mockReturnValue({
        saveConfig: mockSaveConfig,
        updateModelTypeConfig: vi.fn().mockRejectedValue(new Error('Network error')),
      });
      
      render(<SettingsPanel />);

      // Make changes
      const apiKeyInput = await screen.findByLabelText(/api key/i);
      await userEvent.type(apiKeyInput, 'some-key');
      
      // Try to save
      const saveButton = screen.getByText('Save Changes');
      await userEvent.click(saveButton);
      
      // Should handle error gracefully
      await waitFor(() => {
        expect(screen.getByText('Network error')).toBeInTheDocument();
      });
    });
  });

  describe('Performance with Complex Configurations', () => {
    it('should handle configuration with many providers efficiently', async () => {
      // Mock configuration with many providers
      const complexConfig = {
        ai: {
          default_provider: 'openai',
          default_model: 'gpt-3.5-turbo',
          model_types: {
            chat: {
              default_provider: 'openai',
              default_model: 'gpt-3.5-turbo',
              available_providers: [
                'openai', 'chatglm', 'anthropic', 'cohere', 'huggingface', 
                'replicate', 'together', 'openrouter', 'perplexity', 'mistral'
              ],
              capabilities: {
                streaming: true,
                thinking: true,
                tool_calling: true,
              },
              api_keys: {
                openai: '',
                chatglm: '',
                anthropic: '',
                cohere: '',
                huggingface: '',
              },
              custom_provider_url: '',
            },
            embedding: {
              default_provider: 'openai',
              default_model: 'text-embedding-ada-002',
              available_providers: [
                'openai', 'huggingface', 'cohere', 'sentence-transformers', 'voyage'
              ],
            },
            rerank: {
              default_provider: 'cohere',
              default_model: 'rerank-english-v2.0',
              available_providers: ['cohere', 'jina', 'voyage'],
            },
          },
          providers: {
            openai: { name: 'OpenAI', config: { apiKey: '', model: 'gpt-3.5-turbo' } },
            chatglm: { name: 'ChatGLM', config: { apiKey: '', model: 'chatglm-6b' } },
            anthropic: { name: 'Anthropic', config: { apiKey: '', model: 'claude-2' } },
            cohere: { name: 'Cohere', config: { apiKey: '', model: 'command' } },
            huggingface: { name: 'Hugging Face', config: { apiKey: '', model: 'gpt2' } },
          },
        },
        ui: {
          theme: 'dark',
          show_token_usage: true,
          auto_scroll: true,
          compact_mode: false,
          font_size: 'medium',
        },
        privacy: {
          analytics_enabled: true,
          data_sharing: false,
        },
      };

      mockUseConfigStore.mockReturnValue({
        config: complexConfig,
        setConfig: vi.fn(),
        updateConfig: vi.fn(),
        loadConfig: vi.fn().mockResolvedValue(complexConfig),
      });

      const startTime = performance.now();
      render(<SettingsPanel />);

      // Should render efficiently even with many providers
      await waitFor(() => {
        expect(screen.getByText('Preferences')).toBeInTheDocument();
      });

      const renderTime = performance.now() - startTime;
      expect(renderTime).toBeLessThan(2000); // Should render in under 2 seconds
    });

    it('should maintain responsiveness during configuration changes', async () => {
      const user = userEvent.setup();
      
      render(<SettingsPanel />);

      // Make rapid configuration changes
      const apiKeyInput = await screen.findByLabelText(/api key/i);
      
      await act(async () => {
        for (let i = 0; i < 5; i++) {
          await user.type(apiKeyInput, `key${i}`);
          await user.clear(apiKeyInput);
        }
      });

      // UI should remain responsive
      expect(apiKeyInput).toBeInTheDocument();
    });
  });

  describe('Real-world Configuration Scenarios', () => {
    it('should support developer workflow: setup -> test -> save', async () => {
      const user = userEvent.setup();
      const mockSaveConfig = vi.fn().mockResolvedValue(undefined);
      
      mockUseService.mockReturnValue({
        saveConfig: mockSaveConfig,
        updateModelTypeConfig: vi.fn().mockResolvedValue(undefined),
      });

      // Mock successful API validation
      mockElectronAPI.catalyst.listProviders.mockResolvedValue({
        success: true,
        providers: ['gpt-3.5-turbo', 'gpt-4'],
      });

      render(<SettingsPanel />);

      // Setup: Enter API key
      const apiKeyInput = await screen.findByLabelText(/api key/i);
      await user.type(apiKeyInput, 'dev-test-key-123');
      
      // Test: Verify connection
      const testButton = screen.getByText('Test Connection');
      await user.click(testButton);
      
      await waitFor(() => {
        expect(screen.getByText('Connection successful')).toBeInTheDocument();
      });
      
      // Save: Apply configuration
      const saveButton = screen.getByText('Save Changes');
      await user.click(saveButton);
      
      // Verify all steps completed successfully
      await waitFor(() => {
        expect(mockSaveConfig).toHaveBeenCalledWith(
          expect.objectContaining({
            ai: expect.objectContaining({
              model_types: expect.objectContaining({
                chat: expect.objectContaining({
                  api_keys: expect.objectContaining({
                    openai: 'dev-test-key-123'
                  })
                })
              })
            })
          })
        );
      });
    });

    it('should support multi-provider setup for different model types', async () => {
      const user = userEvent.setup();
      
      render(<SettingsPanel />);

      // Setup different providers for different model types
      const chatProvider = await screen.findByRole('combobox', { name: /chat provider/i });
      await user.click(chatProvider);
      const anthropicOption = screen.getByText('anthropic');
      await user.click(anthropicOption);
      
      const embeddingProvider = screen.getByRole('combobox', { name: /embedding provider/i });
      await user.click(embeddingProvider);
      const hfOption = screen.getByText('huggingface');
      await user.click(hfOption);
      
      // Verify both providers are set
      expect(chatProvider).toHaveValue('anthropic');
      expect(embeddingProvider).toHaveValue('huggingface');
    });

    it('should handle configuration import/export scenarios', async () => {
      const user = userEvent.setup();
      
      render(<SettingsPanel />);

      // Find export/import functionality
      await waitFor(() => {
        const importButton = screen.getByText('Import Settings');
        expect(importButton).toBeInTheDocument();
      });
      
      const exportButton = screen.getByText('Export Settings');
      expect(exportButton).toBeInTheDocument();
      
      // Simulate export
      await user.click(exportButton);
      
      // Would verify that configuration was exported
      // Actual implementation would depend on your export functionality
    });
  });

  describe('Accessibility and Keyboard Navigation', () => {
    it('should be fully navigable via keyboard', async () => {
      const user = userEvent.setup();
      
      render(<SettingsPanel />);

      // Tab through main elements
      const initialFocus = screen.getByText('Preferences'); // Can be focused
      initialFocus.focus();
      
      // Navigate using keyboard
      await user.tab();
      expect(screen.getByRole('button', { name: 'Save Changes' })).toHaveFocus();
      
      await user.tab();
      const providerSelect = await screen.findByRole('combobox', { name: /provider/i });
      expect(providerSelect).toHaveFocus();
    });

    it('should provide proper labels and descriptions', async () => {
      render(<SettingsPanel />);

      // Verify important elements have proper labels
      const apiKeyInput = await screen.findByLabelText(/api key/i);
      expect(apiKeyInput).toBeInTheDocument();
      
      const themeSelect = screen.getByRole('combobox', { name: /theme/i });
      expect(themeSelect).toBeInTheDocument();
      
      const saveButton = screen.getByRole('button', { name: 'Save Changes' });
      expect(saveButton).toBeInTheDocument();
    });
  });

  afterEach(() => {
    vi.clearAllMocks();
  });
});