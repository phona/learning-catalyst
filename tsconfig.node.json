{
  "compilerOptions": {
	"jsx": "react",
    "composite": true,
    "skipLibCheck": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@/renderer/*": [
        "src/renderer/*"
      ],
      "@/main/*": [
        "src/main/*"
      ],
      "@/shared/*": [
        "src/shared/*"
      ]
    }
  },
  "include": ["vite.config.ts"],
  "exclude": ["node_modules", "src/**/*"]
}