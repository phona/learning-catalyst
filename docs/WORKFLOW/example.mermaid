sequenceDiagram
    title Module X Learning Workflow (Simplified)
    autonumber

    %% --- PARTICIPANTS ---
    actor User
    participant Orch as Orchestrator
    participant Mem as MemoryDB
    participant Teach as Learning Agent
    participant Ex as Practice Agent
    participant Eval as Assessment Agent

    %% --- INITIALIZATION ---
    User->>Orch: Start Module X
    Orch->>Eval: Initialize & Assess Readiness
    Eval->>Mem: Fetch User Profile & History
    Mem-->>Eval: Profile Data
    Eval-->>Orch: Readiness Report (Confidence Level)

    %% --- STEP 1: FAST TRACK CHECK ---
    rect rgb(230, 240, 255)
        alt High Confidence Report
            Orch->>User: Offer Fast Track (Quiz)
            User->>Orch: Accept
            Orch->>Ex: Generate Diagnostic Assessment
            Ex-->>User: Assessment Interface
            Note over Orch,User: Wait for user answers (checkpoint stored)
            opt No Response / Timeout
                Orch-->>User: Reminder or Offer Break
            end
            User->>Ex: Submit Answers
            Ex->>Eval: Analyze & Identify Gaps
            
            alt Passed (>90%)
                Eval-->>Orch: Result: EXPERT
                Orch->>User: Mark Complete (Skip Lesson)
            else Failed
                Eval-->>Orch: Result: NOVICE (Gaps: X, Y, Z)
                Orch->>User: "We'll focus on your gaps in X, Y..."
            end
        end
    end

    %% --- STEP 2: STANDARD LEARNING LOOP ---
    rect rgb(255, 250, 230)
        loop Standard Learning Cycle
            %% A. TEACHING
            Orch->>Teach: Teach Concept (Tailored to Gaps)
            Teach-->>User: Deliver Lesson
            loop Q&A
                User->>Teach: Ask Question / Clarify
                Teach-->>User: Provide Clarification / Example
            end
            
            %% B. PRACTICE
            Orch->>Ex: Generate Practice Problem
            Ex-->>User: Problem Display
            Note over Orch,User: Wait for user answer (checkpoint stored)
            
            opt No Response / Timeout
                Orch-->>User: Reminder or Offer Break
            end

            User->>Ex: Submit Answer
            Ex->>Eval: Analyze Answer
            
            rect rgb(255, 255, 255)
                alt Correct Answer
                    Eval-->>Orch: Result: SUCCESS
                    Orch->>Eval: Run Mastery Pulse Check
                    Eval-->>Orch: Mastery OK?
                    alt Mastery OK
                        Orch->>User: Celebrate & Next Topic
                    else Needs Reinforcement
                        Orch->>Ex: Assign Reinforcement Practice
                        Ex-->>User: Extra Practice Item
                        Note over Orch,User: Wait for user answer (checkpoint stored)
                        User->>Ex: Submit Answer
                        Ex->>Eval: Analyze Answer
                    end
                else Incorrect Answer
                    Eval-->>Orch: Result: FAILURE
                    
                    %% C. INTERVENTION LOGIC (Flattened)
                    rect rgb(255, 235, 235)
                        opt Major Knowledge Gap detected
                            Orch->>Teach: Inject Prerequisite Lesson
                            Teach-->>User: "Let's review a foundational concept first..."
                            Teach-->>User: [Delivers Prerequisite Content]
                        end
                    end
                    
                    rect rgb(245, 245, 245)
                        opt Persistent Failure (Circuit Breaker)
                            Orch->>User: Suggest Break / Human Handoff
                        end
                    end

                    %% Default Fallback
                    Orch->>Teach: Re-explain Concept
                    Teach-->>User: Targeted Hint
                end
            end
        end
    end
