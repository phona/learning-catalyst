{
  "name": "learning-catalyst-desktop",
  "type": "module",
  "version": "1.0.0",
  "description": "AI-driven interactive learning companion - Desktop Edition",
  "main": "dist-electron/main/index.js",
  "homepage": "./",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--max_old_space_size=1024 --enable-source-maps\" TRANSFORMERS_DISABLE_CPU=1 WORKSPACE_PATH=test_workspace vite",
    "build": "vite build && electron-builder",
    "preview": "vite preview",
    "build:all": "vite build && electron-builder --publish=never",
    "lint": "eslint src/**/*.ts src/**/*.tsx",
    "lint:file": "eslint",
    "type-check": "tsc --noEmit --skipLibCheck -p tsconfig.build.json",
    "test": "npm run test:main && npm run test:renderer",
    "test:ui": "npm run test:main:ui && npm run test:renderer:ui",
    "test:run": "npm run test:main && npm run test:renderer",
    "test:coverage": "npm run test:main:coverage && npm run test:renderer:coverage",
    "test:main": "vitest --config vitest.main.config.ts --run",
    "test:renderer": "vitest --config vitest.renderer.config.ts --run",
    "test:main:ui": "vitest --config vitest.main.config.ts --ui",
    "test:renderer:ui": "vitest --config vitest.renderer.config.ts --ui",
    "test:main:coverage": "vitest run --config vitest.main.config.ts --coverage",
    "test:renderer:coverage": "vitest run --config vitest.renderer.config.ts --coverage",
    "test:main:memory": "vitest run --config vitest.main.config.ts src/test/performance/memory-leak-detection.test.ts",
    "test:main:integration": "vitest run --config vitest.main.config.ts src/test/integration/cross-service.integration.test.ts",
    "test:main:complete": "npm run test:main && npm run test:main:memory && npm run test:main:integration",
    "test:main:complete:coverage": "npm run test:main:coverage && npm run test:main:memory && npm run test:main:integration",
    "test:main:file": "vitest --config vitest.main.config.ts --run",
    "test:all": "npm run test:main && npm run test:renderer",
    "test:all:coverage": "npm run test:main:coverage && npm run test:renderer:coverage",
    "test:integration": "vitest --config vitest.integration.config.ts",
    "test:integration:ui": "vitest --config vitest.integration.config.ts --ui",
    "test:integration:coverage": "vitest run --config vitest.integration.config.ts --coverage",
    "test:renderer:file": "vitest --config vitest.renderer.config.ts --run",
    "test:render-safety": "vitest --config vitest.renderer.config.ts --run src/renderer/__tests__/render-safety.test.tsx",
    "test:errors": "vitest --config vitest.renderer.config.ts --run src/renderer/__tests__/electron-api.contract.test.ts",
    "test:contracts": "vitest --config vitest.renderer.config.ts --run src/renderer/__tests__/electron-api.contract.test.ts",
    "test:performance": "vitest --config vitest.performance.config.ts",
    "test:performance:ui": "vitest --config vitest.performance.config.ts --ui",
    "test:performance:coverage": "vitest run --config vitest.performance.config.ts --coverage",
    "test:complete": "npm run test:main && npm run test:renderer && npm run test:integration",
    "test:complete:coverage": "npm run test:main:coverage && npm run test:renderer:coverage && npm run test:integration:coverage",
    "rebuild": "electron-rebuild",
    "qdrant:start": "node -e \"require('./external/qdrant/start-qdrant.js').start()\"",
    "qdrant:stop": "node -e \"require('./external/qdrant/start-qdrant.js').stop()\"",
    "qdrant:status": "node -e \"require('./external/qdrant/start-qdrant.js').status()\"",
    "setup:qdrant": "node scripts/setup-qdrant.js",
    "postinstall": "electron-builder install-app-deps",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "education",
    "ai",
    "learning",
    "electron",
    "typescript",
    "desktop"
  ],
  "author": "Learning Catalyst Team",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/langchain": "^1.0.115",
    "@ai-sdk/provider-utils": "^3.0.19",
    "@assistant-ui/react": "^0.11.51",
    "@assistant-ui/react-ai-sdk": "^1.1.16",
    "@assistant-ui/react-markdown": "^0.11.8",
    "@assistant-ui/react-ui": "^0.2.1",
    "@babel/preset-react": "^7.28.5",
    "@heroicons/react": "^2.0.16",
    "@langchain/core": "^1.1.3",
    "@langchain/langgraph": "^1.0.1",
    "@langchain/langgraph-checkpoint": "^1.0.0",
    "@langchain/openai": "^1.0.0",
    "@langchain/textsplitters": "^1.0.0",
    "@qdrant/qdrant-js": "1.16.1",
    "@rollup/rollup-linux-x64-gnu": "^4.54.0",
    "@tanstack/react-query": "^4.24.6",
    "@types/lodash": "^4.17.20",
    "better-sqlite3": "12.5.0",
    "clsx": "^2.1.1",
    "date-fns": "^2.29.3",
    "kysely": "^0.28.8",
    "langchain": "^1.0.3",
    "lodash": "^4.17.21",
    "lucide-react": "^0.561.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.0",
    "react-router-dom": "^6.8.0",
    "react-syntax-highlighter": "^15.5.0",
    "relation-graph-react": "^2.2.11",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "source-map-support": "^0.5.21",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^3.2.7",
    "ts-chan": "^0.6.0",
    "unified": "^11.0.4",
    "uuid": "^9.0.0",
    "winston": "^3.19.0",
    "zod": "^4.1.13",
    "zustand": "^4.3.6"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@eslint/js": "^8.57.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^18.14.6",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@types/react-syntax-highlighter": "^15.5.6",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "@vitejs/plugin-react": "^3.1.0",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "autoprefixer": "^10.4.14",
    "cross-env": "^10.1.0",
    "depcheck": "^1.4.7",
    "electron": "^39.0.0",
    "electron-builder": "^23.6.0",
    "electron-rebuild": "^3.2.9",
    "eslint": "^8.35.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "globals": "^15.9.0",
    "jsdom": "^27.1.0",
    "madge": "^8.0.0",
    "postcss": "^8.4.21",
    "prettier": "^3.3.3",
    "reflect-metadata": "^0.2.2",
    "ts-prune": "^0.10.3",
    "typescript": "^5.9.3",
    "vite": "^4.5.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^4.0.16"
  },
  "build": {
    "appId": "org.learningcatalyst.desktop",
    "productName": "Learning Catalyst",
    "asarUnpack": [
      "**/*.node"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "package.json",
      "external/qdrant/**/*"
    ],
    "mac": {
      "category": "public.app-category.education"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
